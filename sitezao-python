<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Python — Fundamentos</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;600;800&family=Syne:wght@400;600;800&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0e17;
    --surface: #111827;
    --card: #161f2e;
    --border: #1e2d42;
    --py-yellow: #ffd43b;
    --py-blue: #4b8bbe;
    --py-blue-light: #5ba3d9;
    --green: #3ecf8e;
    --orange: #ff7b39;
    --pink: #e879f9;
    --text: #e2e8f0;
    --muted: #64748b;
    --comment: #4a5568;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Syne', sans-serif;
    overflow-x: hidden;
  }

  /* ─── GRID BACKGROUND ─── */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(75,139,190,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(75,139,190,0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    pointer-events: none;
    z-index: 0;
  }

  /* ─── HERO ─── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 6rem 2rem 4rem;
    overflow: hidden;
    z-index: 1;
  }

  .hero-glow {
    position: absolute;
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(75,139,190,0.18) 0%, rgba(255,212,59,0.06) 50%, transparent 70%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse 5s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulse {
    0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.7; }
    50% { transform: translate(-50%, -50%) scale(1.1); opacity: 1; }
  }

  .snake-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255,212,59,0.1);
    border: 1px solid rgba(255,212,59,0.3);
    border-radius: 999px;
    padding: 0.4rem 1.2rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--py-yellow);
    margin-bottom: 2rem;
    animation: fadeDown 0.8s ease both;
  }

  .snake-badge::before { content: '🐍'; font-size: 1rem; }

  .hero h1 {
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.03em;
    animation: fadeDown 0.9s ease 0.1s both;
  }

  .hero h1 .yellow { color: var(--py-yellow); }
  .hero h1 .blue { color: var(--py-blue-light); }

  .hero-sub {
    margin-top: 1.5rem;
    font-size: 1.1rem;
    color: var(--muted);
    max-width: 480px;
    line-height: 1.7;
    animation: fadeDown 0.9s ease 0.2s both;
  }

  .hero-cta {
    margin-top: 2.5rem;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    animation: fadeDown 0.9s ease 0.3s both;
  }

  .btn {
    padding: 0.85rem 2rem;
    border-radius: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    border: none;
  }

  .btn-primary {
    background: var(--py-yellow);
    color: #000;
  }

  .btn-primary:hover { background: #ffe066; transform: translateY(-2px); box-shadow: 0 8px 32px rgba(255,212,59,0.3); }

  .btn-ghost {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover { border-color: var(--py-blue); color: var(--py-blue-light); }

  /* ─── TERMINAL PREVIEW ─── */
  .terminal-wrap {
    margin-top: 4rem;
    width: 100%;
    max-width: 600px;
    animation: fadeUp 1s ease 0.5s both;
    position: relative;
    z-index: 1;
  }

  .terminal {
    background: #0d1117;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.6);
    text-align: left;
  }

  .terminal-bar {
    background: #1c2432;
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .terminal-title {
    margin-left: auto;
    margin-right: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--muted);
  }

  .terminal-body {
    padding: 1.5rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    line-height: 1.8;
  }

  .t-kw { color: #cc99cd; }
  .t-fn { color: var(--py-blue-light); }
  .t-str { color: var(--green); }
  .t-num { color: var(--orange); }
  .t-var { color: var(--text); }
  .t-op { color: var(--py-yellow); }
  .t-comment { color: var(--comment); font-style: italic; }
  .t-out { color: var(--muted); border-left: 2px solid var(--border); padding-left: 0.75rem; }

  /* ─── NAV ─── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 3rem;
    background: rgba(10,14,23,0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.04);
  }

  .nav-logo {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--py-yellow);
    text-decoration: none;
  }

  .nav-logo span { color: var(--py-blue-light); }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-links a {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--py-yellow); }

  /* ─── SECTIONS ─── */
  section {
    position: relative;
    z-index: 1;
    padding: 6rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    color: var(--py-yellow);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: 1rem;
  }

  .section-desc {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 560px;
    margin-bottom: 3rem;
  }

  /* ─── CONCEPTS GRID ─── */
  .concepts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .concept-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    cursor: default;
  }

  .concept-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 60px rgba(0,0,0,0.4);
  }

  .concept-card:hover .card-accent { opacity: 1; }

  .card-accent {
    height: 3px;
    opacity: 0.5;
    transition: opacity 0.3s;
  }

  .accent-yellow { background: var(--py-yellow); }
  .accent-blue { background: var(--py-blue-light); }
  .accent-green { background: var(--green); }
  .accent-orange { background: var(--orange); }
  .accent-pink { background: var(--pink); }

  .card-inner { padding: 1.75rem; }

  .card-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
    margin-bottom: 1.25rem;
  }

  .icon-yellow { background: rgba(255,212,59,0.12); }
  .icon-blue { background: rgba(91,163,217,0.12); }
  .icon-green { background: rgba(62,207,142,0.12); }
  .icon-orange { background: rgba(255,123,57,0.12); }
  .icon-pink { background: rgba(232,121,249,0.12); }

  .card-title {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-desc {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* ─── CODE BLOCK ─── */
  .code-block {
    background: #0d1117;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1.25rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    line-height: 1.8;
    overflow-x: auto;
  }

  /* ─── INTERACTIVE TABS ─── */
  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .tab-btn {
    padding: 0.5rem 1rem;
    border-radius: 6px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--muted);
    transition: all 0.2s;
  }

  .tab-btn.active {
    background: var(--py-yellow);
    color: #000;
    border-color: var(--py-yellow);
  }

  .tab-btn:hover:not(.active) { border-color: var(--py-blue); color: var(--py-blue-light); }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ─── LARGE CODE DEMO ─── */
  .demo-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: start;
  }

  @media (max-width: 700px) {
    .demo-wrap { grid-template-columns: 1fr; }
    nav { padding: 1rem 1.5rem; }
    .nav-links { display: none; }
  }

  .demo-info h3 {
    font-size: 1.5rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .demo-info p {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    margin-top: 1rem;
    margin-right: 0.4rem;
    border: 1px solid;
  }

  .tag-yellow { color: var(--py-yellow); border-color: rgba(255,212,59,0.3); background: rgba(255,212,59,0.07); }
  .tag-blue { color: var(--py-blue-light); border-color: rgba(91,163,217,0.3); background: rgba(91,163,217,0.07); }
  .tag-green { color: var(--green); border-color: rgba(62,207,142,0.3); background: rgba(62,207,142,0.07); }

  /* ─── FOOTER ─── */
  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 3rem 2rem;
    border-top: 1px solid var(--border);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    color: var(--comment);
  }

  footer span { color: var(--py-yellow); }

  /* ─── ANIMATIONS ─── */
  @keyframes fadeDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: none;
  }

  /* ─── DIVIDER ─── */
  .divider {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }

  /* ─── SCROLL INDICATOR ─── */
  .scroll-down {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--comment);
    animation: fadeUp 1s ease 1s both;
    text-decoration: none;
  }

  .scroll-arrow {
    width: 20px;
    height: 30px;
    border: 1px solid var(--border);
    border-radius: 10px;
    display: flex;
    justify-content: center;
    padding-top: 5px;
  }

  .scroll-dot {
    width: 4px;
    height: 6px;
    background: var(--py-yellow);
    border-radius: 2px;
    animation: scrollBounce 1.5s ease-in-out infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50% { transform: translateY(8px); opacity: 0.3; }
  }

  /* ─── LINE NUMBERS ─── */
  .ln { color: var(--comment); user-select: none; margin-right: 1rem; }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a class="nav-logo" href="#">py<span>thon</span></a>
  <ul class="nav-links">
    <li><a href="#conceitos">Conceitos</a></li>
    <li><a href="#listas">Listas</a></li>
    <li><a href="#condicionais">Condicionais</a></li>
